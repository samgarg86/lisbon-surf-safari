

<div class="quantity-dropdown-wrapper" {{ block.shopify_attributes }}>
  {%- if block.settings.label != blank -%}
    <label for="quantity-dropdown-{{ block.id }}" class="quantity-dropdown-label">
      {{ block.settings.label }}:
    </label>
  {%- endif -%}
  <select
    id="quantity-dropdown-{{ block.id }}"
    name="quantity"
    class="quantity-dropdown"
  >
    {%- for i in (1..block.settings.max_quantity) -%}
      <option value="{{ i }}">{{ i }}</option>
    {%- endfor -%}
  </select>
</div>

{% stylesheet %}
  .quantity-dropdown-wrapper {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  .quantity-dropdown-label {
    font-size: var(--font-size--sm);
    white-space: nowrap;
  }

  .quantity-dropdown {
    padding: var(--padding-xs) var(--padding-sm);
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: var(--font-size--sm);
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Number of surfers"
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:names.quantity",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
