
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} split-showcase-with-header{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  data-testid="split-showcase-with-header"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div
      class="split-showcase-with-header__header"
      style="text-align: {{ section.settings.text_alignment }};"
    >
      {%- if section.settings.heading != blank -%}
        <div class="split-showcase-with-header__heading">{{- section.settings.heading -}}</div>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="split-showcase-with-header__subheading">{{- section.settings.subheading -}}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="split-showcase-with-header__panels"
    style="
      {%- if section.settings.panels_height == 'full-screen' -%}
        min-height: 100svh;
      {%- elsif section.settings.panels_height != 'auto' -%}
        min-height: var(--section-height-{{ section.settings.panels_height }});
      {%- endif -%}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .split-showcase-with-header__header {
    padding-block: var(--page-margin);
    padding-inline: var(--page-margin);
  }

  .section--page-width .split-showcase-with-header__header {
    padding-inline: 0;
  }

  .split-showcase-with-header__heading {
    font-size: var(--font-h2--size);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    line-height: var(--font-heading--line-height);
    letter-spacing: var(--font-heading--letter-spacing);
  }

  .split-showcase-with-header__heading p {
    margin: 0 0 0.4em;
  }

  .split-showcase-with-header__heading p:last-child {
    margin-bottom: 0;
  }

  .split-showcase-with-header__subheading {
    margin: 0;
  }

  .split-showcase-with-header__panels {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    .split-showcase-with-header__panels {
      flex-direction: row;
    }
  }

  .split-showcase-with-header__panels > .group-block {
    flex: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split showcase + header",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>New arrivals</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "Discover our latest collections"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "panels_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Split showcase + header",
      "category": "t:categories.banners",
      "settings": {
        "heading": "<p>New arrivals</p>",
        "subheading": "Discover our latest collections",
        "text_alignment": "left",
        "section_width": "full-width",
        "panels_height": "large"
      },
      "blocks": {
        "group_1": {
          "type": "group",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "space-between",
            "gap": 32,
            "background_media": "image",
            "placeholder": "hero-apparel-2",
            "height": "fill",
            "width": "fill",
            "padding-block-start": 40,
            "padding-block-end": 40,
            "padding-inline-start": 40,
            "padding-inline-end": 40
          },
          "blocks": {
            "spacer": {
              "type": "spacer",
              "settings": {
                "size": "pixel",
                "pixel_size": 16
              }
            },
            "text_1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.new_arrivals_h3",
                "type_preset": "h3",
                "width": "fit-content",
                "alignment": "center"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "t:text_defaults.shop_now_button_label",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["spacer", "text_1", "button"]
        },
        "group_2": {
          "type": "group",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "space-between",
            "gap": 32,
            "background_media": "image",
            "placeholder": "hero-apparel-1",
            "height": "fill",
            "width": "fill",
            "padding-block-start": 40,
            "padding-block-end": 40,
            "padding-inline-start": 40,
            "padding-inline-end": 40
          },
          "blocks": {
            "spacer": {
              "type": "spacer",
              "settings": {
                "size": "pixel",
                "pixel_size": 16
              }
            },
            "text_1": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.bestseller_h3",
                "type_preset": "h3",
                "width": "fit-content",
                "alignment": "center"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "t:text_defaults.shop_now_button_label",
                "link": "shopify://collections/all",
                "style_class": "button-unstyled"
              }
            }
          },
          "block_order": ["spacer", "text_1", "button"]
        }
      },
      "block_order": ["group_1", "group_2"]
    }
  ]
}
{% endschema %}